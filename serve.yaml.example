# serve.yaml - contextmatrix-chat service configuration
#
# Copy to ~/.config/contextmatrix-chat/serve.yaml (the XDG default location)
# and edit before starting the service. Every field can also be set or
# overridden with a CMX_* environment variable (see each field below).
# Precedence is defaults < file < env. Nested keys use a double-underscore
# separator:
#   CMX_COMPACTION__THRESHOLD=0.85
#   CMX_COMPACTION__KEEP_RECENT_TURNS=6
#
# Credentials are NOT configured here: ContextMatrix provisions the git
# credentials, the LLM endpoint, and the task-skills clone token per session.

# --- ContextMatrix connectivity -----------------------------------------------

# URL of the ContextMatrix API reachable from the chat service host. Required.
# CMX_CONTEXTMATRIX_URL
contextmatrix_url: http://localhost:8080

# URL of the ContextMatrix API as seen from inside worker containers. Workers
# derive their MCP endpoint from this value as <url>/mcp; when unset it falls
# back to contextmatrix_url, which is usually wrong for containers (they would
# point at their own localhost and fail at MCP connect). For Docker bridge
# networking, use the bridge gateway (typically the host's Docker bridge
# address):
#   container_contextmatrix_url: http://172.17.0.1:8080
# For host-network containers or a named Docker network, use the service
# hostname or IP reachable from containers.
# CMX_CONTAINER_CONTEXTMATRIX_URL
# container_contextmatrix_url: http://172.17.0.1:8080

# URL of this service as seen from inside worker containers. Must be http or
# https with a non-loopback host and no path; a trailing slash is trimmed.
# When unset, workers use http://host.docker.internal:<port>, with <port> the
# webhook port below. Workers send their LLM calls to <this URL>/llm, so they
# must be able to reach that port (a host firewall must allow it).
# CMX_CONTAINER_SERVE_URL
# container_serve_url: http://172.17.0.1:9093

# Shared secret between ContextMatrix and the chat service. ContextMatrix signs
# every webhook (and the admin /metrics request) with it; the service verifies
# the HMAC. Must be at least 32 characters. Required.
# CMX_API_KEY
api_key: ""

# Note: ContextMatrix's instance-wide MCP API key and the per-session model are
# NOT configured here - ContextMatrix supplies both in the chat-start payload
# (forwarded to the worker as CM_MCP_API_KEY and CM_MODEL).

# --- Serving ------------------------------------------------------------------

# Port the chat service listens on. Default: 9093.
# CMX_PORT
port: 9093

# Admin listener serving Prometheus /metrics. 0 disables it (the default);
# when set it must differ from port.
# CMX_ADMIN_PORT
# admin_port: 9094

# Address the admin listener binds to. Default 127.0.0.1 (loopback-only). Set
# a LAN address (or 0.0.0.0) to let an external Prometheus scrape /metrics;
# restrict access with a firewall when binding beyond loopback.
# CMX_ADMIN_BIND_ADDR
# admin_bind_addr: "127.0.0.1"

# Static bearer token accepted on GET /metrics as an alternative to the
# HMAC-signed request scheme, for scrapers that cannot sign requests. Use it
# as the `authorization.credentials` value in a Prometheus scrape config.
# Generate with e.g. `openssl rand -hex 32`. Empty keeps /metrics HMAC-only.
# CMX_METRICS_TOKEN
# metrics_token: ""

# Log level: debug | info | warn | error. Default: info.
# CMX_LOG_LEVEL
log_level: info

# --- Worker containers --------------------------------------------------------

# Docker image launched for each chat session. Required. Beyond pinning a digest
# for reproducibility (a non-digest tag is allowed but warns), this is the
# language-toolchain seam: the shipped default (the `full` variant) carries Go,
# Node, Python, and Rust. A project in any other ecosystem (a JVM, Ruby, .NET, a
# system library) needs an image that carries that toolchain - build one FROM a
# published variant (see the agent repo's docs/custom-images.md pattern).
# Projects override this per-board via the chat worker image in ContextMatrix's
# project settings.
# CMX_BASE_IMAGE
# base_image: ghcr.io/mhersson/contextmatrix-chat@sha256:<digest>

# Image pull policy: never | if-not-present | always. Default: if-not-present.
# CMX_IMAGE_PULL_POLICY
image_pull_policy: if-not-present

# Substring filters for GET /images (the ContextMatrix settings dropdown).
# An image tag is listed when it contains any of these substrings; images with
# no matching tag are omitted. Default: [contextmatrix-chat]. YAML only - the
# CMX_ env layer cannot express list values.
# image_list_filters:
#   - contextmatrix-chat

# Maximum number of concurrent worker containers. Must be >= 1. Default: 5.
# CMX_MAX_CONCURRENT
max_concurrent: 5

# Maximum container memory in bytes. Default: 8589934592 (8 GiB).
# CMX_CONTAINER_MEMORY_LIMIT
container_memory_limit: 8589934592

# Maximum container PID count (cgroup pids limit - threads count too, so a
# parallel test suite on a many-core host needs headroom). Default: 2048.
# CMX_CONTAINER_PIDS_LIMIT
container_pids_limit: 2048

# Host directory the service uses for its working state - today only the
# task-skills clone cache (<secrets_dir>/task-skills-cache). Credentials are
# CM-provisioned per session and never staged here.
# Default: /var/run/cm-chat/secrets.
# CMX_SECRETS_DIR
secrets_dir: /var/run/cm-chat/secrets

# Host root under which per-session run directories (resume.jsonl) are
# created and bind-mounted read-only at /run/cm-chat. Required.
# CMX_CHAT_RUN_DIR
# chat_run_dir: /var/run/cm-chat/sessions

# Additional environment variables injected verbatim into every worker
# container, after the CM_*/CMX_* system vars (so an explicit entry overrides a
# system default for any duplicate key). Useful for operator-specific
# passthrough. Limits: overriding LLM_API_KEY needs LLM_BASE_URL as well; the
# pair bypasses the LLM proxy and puts that key in the container. An HTTP proxy
# here needs the serve host (host.docker.internal by default) in NO_PROXY, and
# does not govern LLM calls: those leave from serve, so serve's own
# HTTP(S)_PROXY / NO_PROXY environment applies (set it on its service unit).
# worker_extra_env:
#   HTTP_PROXY: http://proxy.example.com:3128
#   NO_PROXY: localhost,127.0.0.1,host.docker.internal

# Optional host path to a PEM file of extra CA certificate(s) - e.g. the CA of a
# TLS-inspecting egress proxy. Container-only: when set, the file is bind-mounted
# read-only into each worker at /run/cm-ca/ca.crt and the worker's outbound TLS
# (harness LLM client, MCP bridge) and the code-driven initial git clone
# (GIT_SSL_CAINFO) trust it in addition to the system store. NOTE: model-invoked
# bash-tool commands (curl/pip/npm, and any model-run git/gh) go through the
# harness bash tool, which scrubs env, so they do NOT trust this CA without a
# harness change - intentionally out of scope. The host-side service (GitHub auth,
# task-skills fetch) uses the OS/pod trust store and is intentionally NOT affected,
# except the host-side LLM proxy, which also trusts this CA for its upstream calls.
# Empty disables it; when set the file must exist on the host. Must be a readable PEM.
# CMX_CA_CERT_FILE
# ca_cert_file: /etc/contextmatrix-chat/egress-ca.pem

# --- Task skills --------------------------------------------------------------

# No configuration. Task-skills are sourced from ContextMatrix - the single
# source of truth. Chat fetches a {git_remote_url, ref} pointer from CM, clones
# it on the host, and mounts the clone read-only into each worker at
# /run/cm-skills. What is served is governed by CM's own task_skills config
# (task_skills.dir / task_skills.git_remote_url); the chat backend's HMAC key
# (api_key above) must match CM's backends.chat.api_key.

# --- In-context compaction ----------------------------------------------------

compaction:
  # Fraction of the model's context window at which older messages are dropped.
  # Must be in (0, 1]. Default: 0.85.
  # CMX_COMPACTION__THRESHOLD
  threshold: 0.85

  # Number of most-recent messages retained verbatim when compaction fires.
  # A tool-using turn is one assistant message plus one per tool call.
  # Default: 6.
  # CMX_COMPACTION__KEEP_RECENT_TURNS
  keep_recent_turns: 6

# --- Webhook replay protection ------------------------------------------------

# Maximum clock skew (in seconds) tolerated between ContextMatrix and the chat
# service when validating HMAC timestamps. Default: 330 (5.5 minutes).
# CMX_WEBHOOK_REPLAY_SKEW_SECONDS
webhook_replay_skew_seconds: 330

# Maximum number of recent request signatures retained for replay detection.
# Default: 10000.
# CMX_WEBHOOK_REPLAY_CACHE_SIZE
webhook_replay_cache_size: 10000

# --- Message deduplication ----------------------------------------------------

# How long a delivered message_id is retained to suppress retries. Default: 600s.
# CMX_MESSAGE_DEDUP_TTL_SECONDS
message_dedup_ttl_seconds: 600

# Maximum number of message_ids retained for deduplication. Default: 1000.
# CMX_MESSAGE_DEDUP_CACHE_SIZE
message_dedup_cache_size: 1000

# --- Worker CMX_* knobs -------------------------------------------------------

# Maximum wall-clock seconds a bash tool call may run inside a worker container.
# Forwarded as CMX_BASH_TIMEOUT_MAX_SECONDS. Default: 600.
# CMX_BASH_TIMEOUT_MAX_SECONDS
bash_timeout_max_seconds: 600

# Maximum bytes of tool output returned to the model per turn (128 KB backstop).
# Forwarded as CMX_TOOL_OUTPUT_MAX_BYTES. Default: 131072.
# CMX_TOOL_OUTPUT_MAX_BYTES
tool_output_max_bytes: 131072

# Static reasoning effort applied to every chat session (low | medium | high).
# Forwarded as CMX_REASONING_EFFORT to every worker container. Leave empty (the
# default) to send no effort: each model reasons at its own default, and a model
# that always reasons still does. Reasoning replay does not depend on this
# setting. Footgun: this is sent to every selected model; the endpoint must
# accept reasoning_effort on all served models, or leave empty.
# CMX_REASONING_EFFORT
# reasoning_effort: ""

# Reasoning replay: each reply's reasoning goes back with later requests of the
# same chat epoch, so the model continues from its own thinking instead of
# working it out again. Both LLM endpoint types get it; an OpenRouter-type
# endpoint is also pinned to the provider that served the newest reasoning, and
# reasoning from any other provider is dropped. A /clear or a resumed session
# starts without it: resume history is text-only. Replayed reasoning bills as
# input and fills the context window sooner, so compaction fires earlier. A
# request carrying reasoning that the endpoint rejects with a 400 is resent once
# without it, and the chat transcript shows a replay_dropped line; if those
# recur, turn this off. With a router model id, a later request may reach a
# model that ignores or rejects the earlier reasoning.
# Forwarded as CMX_REPLAY_REASONING=true to every worker container.
# Default: true.
# CMX_REPLAY_REASONING
replay_reasoning: true
